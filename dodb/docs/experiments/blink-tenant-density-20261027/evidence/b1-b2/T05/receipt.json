  "acceptance_mapping": [
    {
      "criterion": "Runtime roots and selected durable manifest root are pinned and identity-bound",
      "evidence": "manifest_roots_keep_old_reader_sources_across_checkpoint_publication; pin_root checks VersionIndex store identity and pin_manifest_root selects the current durable root",
      "result": "pass"
    },
    {
      "criterion": "Checkpoint publication does not invalidate an old reader source; exact prior bytes remain readable after handle close/reopen",
      "evidence": "manifest_roots_keep_old_reader_sources_across_checkpoint_publication reads exact checkpoint page bytes before and after reopening the source handle",
      "result": "pass"
    },
    {
      "criterion": "Sources become reclaimable only after protected roots/dependencies and active handles drop",
      "evidence": "old and current manifest roots protect both sources; dropping only old root reclaims only its source; active source lease blocks unlink",
      "result": "pass"
    },
    {
      "criterion": "Load acquisition races retirement without reading an unlinked source",
      "evidence": "load_acquisition_racing_retirement_never_reads_an_unlinked_source uses a three-party barrier and validates either lease-first or GC-first outcome",
      "result": "pass"
    },
    {
      "criterion": "Bounded mark/sweep preserves delta predecessors and unknown/foreign files",
      "evidence": "VersionIndex::visit_sources streams descriptors into per-run disk marks; WAL-based delta roots conservatively retain WAL candidates; foreign unrecognized file remains",
      "result": "pass"
    },
    {
      "criterion": "Missing reachable source and wrong identity fail closed",
      "evidence": "missing_index_reachable_source_is_corruption and active_read_lease_blocks_retirement_and_reopen_checks_exact_header",
      "result": "pass"
    },
    {
      "criterion": "Fault boundaries before and after unlink preserve accurate state",
      "evidence": "source_gc_preserves_reachable_files_across_unlink_fault_boundaries verifies pre-unlink failure retains source and post-unlink failure reports an already removed unreachable source",
      "result": "pass"
    },
    {
      "criterion": "Bound open handles, root registrations, and GC progress; report byte categories separately",
